# Environment and secrets
.env
.env.*
!.env.example
config.local.php
secrets/
*.secret

# Database
# Ignore ad-hoc dumps and scratch SQL, but the shipped schema and migrations
# MUST be committed -- they are required to install the application.
*.sql
!database/schema.sql
!database/*.sql
!database/migrations/*.sql
!db/migrations/*.sql
database/credentials*.sql
*.db
*.sqlite
database/credentials.php
*.dump

# Credentials and keys
*.pem
*.key
*.p12
*.pfx
id_rsa*
*_key
ssh_tunnel_agent.sh
firewall_*_key

# Passwords and tokens
*password*.txt
*token*.txt
*secret*.txt
*credentials*.txt

# Backups (catch *.bak, *.bak_col, *.backup_pre_fix, etc.)
*.backup
*.backup_*
*.backup.*
*.bak
*.bak_*
*.bak.*
*.old
*.orig
*.save
backup/
backups/
# Operational DB/file rescue dumps taken before destructive cleanups. These hold
# production rows and OPNsense config.xml, which carries credentials and keys.
backups_db/
.archive/
*.tar.gz
opnsense_backup_*.tar.gz
*_backup_*.php
# ...but scripts/ holds real tooling that matches that pattern. The rule is aimed
# at stray dated copies left at the repo root (about_backup_20251009.php), and it
# silently swallowed scripts/check_backup_health.php on its first commit.
!scripts/*_backup_*.php

# Logs
*.log
logs/
*.log.*
error_log
access_log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.directory

# IDE
.vscode/
.idea/
*.sublime-*
*.sublime-workspace
*.sublime-project
.project
.settings/
.classpath

# Dependencies
node_modules/
vendor/
bower_components/

# Temp files
tmp/
temp/
*.tmp
cache/
sessions/

# Compiled files
*.pyc
*.pyo
__pycache__/
*.class

# Package files
*.zip
*.tar
*.rar
*.7z

# Release artifacts (tarballs, the signed manifest, AGENT_VERSION.txt) are built,
# not authored, so they stay out of the repo. The plugin installer is the
# exception: it is source that only lives here, and leaving it ignored meant a
# fix to it survived on the release host and nowhere else.
downloads/*
!downloads/plugins/
downloads/plugins/*
!downloads/plugins/install_opnmanager_agent.sh

# Screenshots and images. Binary media is ignored by default; the documentation
# captures under docs/images/github/ are the deliberate exception, because the
# README and docs/SCREENSHOTS.md embed them and they must render on GitHub.
*.gif
*.mp4
*.webm
*.mov

# Capture working files. Raw recordings, generated demo configuration backups and
# any browser auth state stay out of the repository: the media is republished as
# release assets, and the rest regenerates from scripts/demo_fixture.php.
opnmgr-demo-media/
demo-backups/
*.raw.webm
walkthrough.raw.*
screenshots-raw/
.auth/
storageState*.json
playwright/.auth/

# Throwaway scratch files at the top of the working tree.
#
# These are ANCHORED to the repository root on purpose. They used to be bare
# patterns, which match at every depth, and that quietly excluded real product
# files: api/test_email.php (the "Send Test Email" button), api/test_ssl.php and
# api/test_nginx.php (the diagnostics buttons), api/test_pushover.php (the
# "Send Test Push" button) and api/run_bandwidth_test.php. A fresh clone 404'd
# on every one of them, and nobody could have committed a fix, because the fix
# would have been ignored too.
#
# Keep new patterns anchored. An unanchored name here silently removes files
# from the product.
/test_*
/debug_*
/temp_*
/*_test.*
# The committed test suite must ship: CI runs it, and it is the regression guard
# for the agent authentication and authorization behaviour.
!tests/
!tests/*.php

# Scratch files that anchoring made visible. Each was checked: none is
# referenced by any tracked source, and none appears in the released agent
# packages. Listed individually rather than by pattern, so adding a real
# endpoint whose name happens to start with "test" does not silently vanish.
/api/record_bandwidth_test.php
/api/system_test.php
/api/test_api.php
/api/test_api_agent.php
/api/test_data.php
/diagnostics/
/scripts/debug_webport.php
/scripts/test_webport.php
/scripts/test_webport2.php
/scripts/test_webport3.php
/*_debug.*
*_broken*
*.broken
*.broken_*
*.before_move
*.saved
fix_*.sh
fix_*.php
emergency_*
*_fix.php
/simple_*.sh
# ...but the enrollment script is product: api/get_enroll_script.php reads it
# and serves it to firewalls, so a clone without it serves an empty script.
!simple_enroll.sh
super_simple_*.sh

# Old session notes, fix logs, handoff docs
SESSION_*.md
FIXES_*.md
FIX_*.md
*_FIX_*.md
*_HANDOFF*.md
*_REFERENCE*.md
*_ARCHITECTURE*.md
*_DESIGN*.md
HOTFIX_*.md
WORK_SUMMARY*.md
CURRENT_STATUS*.md
ROOT_CAUSE*.md
SOLUTION_SUMMARY*.md
FINAL_FIX*.md
EMERGENCY_*.md
*_SYSTEM_HANGING*.md
*_CONNECTIVITY*.md
*_ISSUE*.md
*_BUG_*.md

# Documentation builds
docs/_build/
site/

# Redundant/old documentation (keep only README, SECURITY, LICENSE)
# Session notes and one-off write-ups that accumulated in the project root.
# Anchored to the root: unanchored, these match at every depth, and they were
# silently swallowing real documentation under docs/ - AGENT_RECOVERY_GUIDE.md
# and AI_LOG_ANALYSIS_IMPLEMENTATION.md were untracked for that reason alone,
# which is the same way product files went missing before.
/*_FIXES_*.md
/*_FIXES.md
/*_CHANGELOG.md
/*_SUMMARY.md
/*_COMPLETE.md
/*_STATUS.md
/*_GUIDE.md
/*_REQUIREMENTS.md
/*_IMPLEMENTATION.md
/*_DEPLOYMENT.md
/KNOWLEDGE_BASE.md
/QUICK_REFERENCE.*

# A session write-up from October 2025 that the anchored rules above no longer
# match. development/documentation.php and todo.php are product pages and stay
# tracked; this one is notes.
development/COMPLETION_SUMMARY.md

# These two describe v2.1.0 and have not been revised since. Left untracked
# deliberately rather than published as if current: they need updating or
# removing, and that is a call about content, not about ignore rules.
docs/QUICK_REFERENCE.md
docs/VERSION_2.1.0_GUIDE.md

# Security scan results
snyk-*.json
security-*.html
vulnerability-*.md
SECURITY_VULNERABILITY_REPORT.md

# System specific
.htaccess.local
robots.txt.local

# Claude Code artifacts
.claude/
.claude.json
.claude.json.backup

# Screenshots and generated docs - keep local only
review_screenshots.html
view_screenshots.html
scripts/capture_gui_screenshots.sh
OPNsense_Manager_Complete_Documentation.pdf
public_screenshots/
screenshots_comprehensive/
screenshots_final/
screenshot_*.png
scripts/capture_screenshots.sh
scripts/capture_authenticated_screenshots.js
scripts/node_modules/
scripts/package.json
scripts/package-lock.json

# Deployment state, not source: written by the updater on each install.
# system_update.php reads the real git checkout, not this file.
COMMIT
